PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/video-processing
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=250
UPLOAD_DIR=uploads
OPENAI_API_KEY="Your OpenAI API Key here"
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_MODERATION_MODEL=omni-moderation-latest
VIDEO_MODERATION_FRAME_COUNT=8. //increase thse value to analyze more frames for better accuracy, but it will also increase processing time
VIDEO_MODERATION_FRAME_WIDTH=768
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
